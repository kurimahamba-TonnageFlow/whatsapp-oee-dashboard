# PostgreSQL connection for the FastAPI backend. Read once by
# src/database.py (load_dotenv -> os.getenv -> psycopg.connect) and used
# by every API module through get_database_connection(). This is the
# only database credential the application has.
#
# MUST use the trusted backend PostgreSQL role - on Supabase that is
# `postgres` (the project owner) or `service_role`.
#
# MUST NOT use `anon`, `authenticated` or `authenticator`. Those roles
# are restricted by Row Level Security and have their privileges revoked
# on the Pulse tables, so the backend would lose access. This applies to
# the Hostinger deployment exactly as it does locally.
#
# Never commit a real value. Never expose this to the frontend - the
# browser only ever receives VITE_API_BASE_URL (see frontend/.env.example).
DATABASE_URL=postgresql://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME

WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_value
WHATSAPP_ALLOWED_GROUP=replace_with_exact_group_name

# Pulse HMI origin allowed by CORS on the /api/v1 routes (src/api.py).
# Must be an exact origin - no wildcards.
HMI_ORIGIN=https://tonnage-flow-pulse-hmi.kurirai-mahamba.chatgpt.site

# Pulse Dashboard origin allowed by CORS on the /api/v1/dashboard routes
# (src/api.py). Must be an exact origin - no wildcards.
DASHBOARD_ORIGIN=https://tonnage-flow-pulse-dashboard.kurirai-mahamba.chatgpt.site

# Management area PIN (src/management_auth.py). Required for
# POST /api/v1/management/login to work at all - required, never given
# a default in code, never committed to source control.
MANAGEMENT_PIN=replace_with_a_long_random_pin

# Optional overrides for Management sessions / login lockout - all have
# sensible defaults in code if unset.
MANAGEMENT_SESSION_MINUTES=30
MANAGEMENT_LOGIN_MAX_ATTEMPTS=5
MANAGEMENT_LOGIN_LOCKOUT_MINUTES=15
MANAGEMENT_MIN_SAMPLE_RUNS=3

# Engineering area PIN (src/engineering_auth.py). Required for
# POST /api/v1/engineering/login to work at all - a separate, shared
# PIN from MANAGEMENT_PIN above. Required, never given a default in
# code, never committed to source control.
ENGINEERING_PIN=replace_with_a_different_long_random_pin

# Optional overrides for Engineering sessions / login lockout - all
# have sensible defaults in code if unset. Entirely separate from the
# MANAGEMENT_* settings above - Engineering and Management sessions
# never share a token or a session store.
ENGINEERING_SESSION_MINUTES=30
ENGINEERING_LOGIN_MAX_ATTEMPTS=5
ENGINEERING_LOGIN_LOCKOUT_MINUTES=15
