WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_value
WHATSAPP_ALLOWED_GROUP=replace_with_exact_group_name

# Pulse HMI origin allowed by CORS on the /api/v1 routes (src/api.py).
# Must be an exact origin - no wildcards.
HMI_ORIGIN=https://tonnage-flow-pulse-hmi.kurirai-mahamba.chatgpt.site

# Pulse Dashboard origin allowed by CORS on the /api/v1/dashboard routes
# (src/api.py). Must be an exact origin - no wildcards.
DASHBOARD_ORIGIN=https://tonnage-flow-pulse-dashboard.kurirai-mahamba.chatgpt.site

# Management area PIN (src/management_auth.py). Required for
# POST /api/v1/management/login to work at all - required, never given
# a default in code, never committed to source control.
MANAGEMENT_PIN=replace_with_a_long_random_pin

# Optional overrides for Management sessions / login lockout - all have
# sensible defaults in code if unset.
MANAGEMENT_SESSION_MINUTES=30
MANAGEMENT_LOGIN_MAX_ATTEMPTS=5
MANAGEMENT_LOGIN_LOCKOUT_MINUTES=15
MANAGEMENT_MIN_SAMPLE_RUNS=3
